# 复制为 .env 后填写；.env 不会被提交到 GitHub

# 必填：随机长字符串，用于登录状态签名。可用 `openssl rand -hex 32` 生成
SECRET_KEY=

# 你的域名（如 studio.example.com）；还没有域名就留空，先用 http://服务器IP 访问
DOMAIN=
# 用了域名和 HTTPS 后改成 1
COOKIE_SECURE=0

# 普通上传（文稿、封面）上限，单位 MB
MAX_UPLOAD_MB=500
# 原片、视频等大文件（分片上传、可断点续传）上限，单位 GB
MAX_LARGE_UPLOAD_GB=100
# 文件存哪里：local = 服务器硬盘（默认）。阿里云 OSS 之后接入
STORAGE_BACKEND=local
# 语音转写用几个 CPU 线程
ASR_THREADS=2
# 未完成的上传多少天没有进展就自动清理（释放磁盘）
UPLOAD_TTL_DAYS=7
# 后台处理（提取音频、转写）在本进程运行。只能有一个进程设为 1；多进程部署时其余设 0
WORKER=1

# AI：用到哪家填哪家
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 试用时不想花钱：所有 AI 步骤走 mock（不调用模型，只回显 prompt）
# PIPELINE_PROVIDER_OVERRIDE=mock
